[Unit]
Description=OmniLodge deployment recovery gate
Documentation=file:/usr/local/share/doc/omnilodge-production/README.md
DefaultDependencies=no
After=local-fs.target
Before=pm2-root.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=omnilodge
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
WorkingDirectory=/var/lib/omnilodge/deploy
ExecStart=/usr/local/sbin/omnilodge-deploy-recover
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
