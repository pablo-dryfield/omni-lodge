#!/bin/sh
set -eu

readonly PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
umask 077

if [ "$#" -ne 0 ] || [ "$(id -u)" -ne 0 ]; then
  printf '%s\n' 'Deployment entry point refused.' >&2
  exit 64
fi

# This deliberately fail-closed entry point is installed during host bootstrap.
# It is replaced by the reviewed protocol-aware submitter before any deployment
# workflow receives production credentials. Keeping a real executable at the
# final sudo path lets visudo and the forced-command boundary be verified early.
printf '%s\n' 'Production deployment is not activated on this host.' >&2
exit 78
