#!/bin/sh
set -eu

readonly PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
umask 077
readonly CONTROL_PLANE_ENTRY='/usr/local/libexec/omnilodge/control-plane/ops/production/libexec/deploy/capture-legacy-baseline-cli.mjs'

if [ "$#" -ne 0 ] || [ "$(id -u)" -ne 0 ]; then
  printf '%s\n' 'Legacy baseline capture refused.' >&2
  exit 64
fi

if [ ! -f "$CONTROL_PLANE_ENTRY" ] || [ -L "$CONTROL_PLANE_ENTRY" ]; then
  printf '%s\n' 'Legacy baseline capture refused.' >&2
  exit 78
fi

exec /usr/bin/env -i \
  HOME=/root \
  USER=root \
  LOGNAME=root \
  NODE_ENV=production \
  PATH="$PATH" \
  /usr/bin/node "$CONTROL_PLANE_ENTRY"
