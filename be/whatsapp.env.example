# WhatsApp Cloud API webhook and read-only brief connector.
# Generate each token independently. Never commit real values.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BRIEF_API_TOKEN=
# Increment this value after deliberately reconnecting/re-onboarding the one
# configured phone number. Account removal remains sticky within a generation.
WHATSAPP_ONBOARDING_GENERATION=1
# Dedicated AES-256-GCM queue key. Generate 32 random bytes and base64-encode them.
# Rotate by changing the active ID/key and retaining up to 3 old id=base64 pairs
# until every row encrypted with those IDs has drained from the durable queue.
WHATSAPP_WEBHOOK_QUEUE_ACTIVE_KEY_ID=queue-key-1
WHATSAPP_WEBHOOK_QUEUE_ACTIVE_KEY=
WHATSAPP_WEBHOOK_QUEUE_PREVIOUS_KEYS=
# Optional separate key for deterministic contact pseudonyms; defaults to the Meta app secret.
WHATSAPP_CONTACT_HASH_KEY=
WHATSAPP_RETENTION_DAYS=7
# Treat a source with no webhook activity in this window as unavailable for briefs.
WHATSAPP_SOURCE_STALE_HOURS=96
