{
  "name": "omnilodge-management-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/server.mjs",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "pg": "8.23.0",
    "ssh2": "1.17.0",
    "ws": "8.22.1",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@types/pg": "8.18.0",
    "@types/ssh2": "1.15.5",
    "@types/ws": "8.18.1",
    "@types/yazl": "3.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
